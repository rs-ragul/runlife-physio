# ==============================================================================
# RUNLIFE PHYSIO — ENVIRONMENT CONFIGURATION (VERCEL + FIREBASE FREE TIER + SEO)
# Copy these variables into Vercel -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Canonical Production Domain (Update once your custom domain or vercel.app URL is live)
NEXT_PUBLIC_SITE_URL=https://www.runlifephysio.com

# 2. Google Search Console HTML Meta Tag Verification Code (Optional — paste only the content string)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 3. Firebase Spark (100% Free Tier) Web App Config
# Get from: https://console.firebase.google.com -> Project Settings -> General -> Your Apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated emails allowed to access /admin portal (defaults to runlifephysio@gmail.com)
NEXT_PUBLIC_ADMIN_EMAILS=runlifephysio@gmail.com

# 4. Optional Email Alerts to runlifephysio@gmail.com when a Patient Books
# OPTION A (100% Free Gmail SMTP — Create a 16-char Google App Password on runlifephysio@gmail.com):
GMAIL_USER=runlifephysio@gmail.com
GMAIL_APP_PASSWORD=

# OPTION B (Alternative: Resend Free Tier API — 3,000 free emails/month):
RESEND_API_KEY=
RESEND_FROM_EMAIL=Runlife Physio <onboarding@resend.dev>

# Destination email for booking & contact notifications
NOTIFICATION_TO_EMAIL=runlifephysio@gmail.com
