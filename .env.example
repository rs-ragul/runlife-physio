# ==============================================================================
# RUNLIFE PHYSIO — ENVIRONMENT CONFIGURATION (VERCEL + FIREBASE FREE TIER + EMAIL)
# Copy these variables into Vercel -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Canonical Production Domain
NEXT_PUBLIC_SITE_URL=https://www.runlifephysio.com

# 2. Google Search Console HTML Meta Tag Verification Code (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 3. Firebase Spark (100% Free Tier) Web App Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated emails allowed to access /admin portal
NEXT_PUBLIC_ADMIN_EMAILS=runlifephysio@gmail.com

# 4. AUTOMATIC EMAIL ALERTS (Pick ANY ONE of Option A, B, or C — all 100% Free!)
NOTIFICATION_TO_EMAIL=runlifephysio@gmail.com

# OPTION A (Recommended — Free Gmail SMTP: sends BOTH Clinic Alert + Patient Auto-Reply!):
# Create a 16-character Google App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=runlifephysio@gmail.com
GMAIL_APP_PASSWORD=

# OPTION B (Easiest 30-Second Setup — No Password Needed!):
# Enter runlifephysio@gmail.com at https://web3forms.com to get a free Access Key:
WEB3FORMS_ACCESS_KEY=

# OPTION C (Alternative — Resend Free Tier API, 3,000 free emails/mo):
RESEND_API_KEY=
RESEND_FROM_EMAIL=Runlife Physio <onboarding@resend.dev>
