rules_version = '2';

// Paste these rules into Firebase Console -> Firestore Database -> Rules
// 100% compatible with Firebase Spark (Free) Plan!
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Only Dr. Vishal / authorized verified admin email can read, update, or delete records
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "runlifephysio@gmail.com"
      );
    }

    // Patient Appointment Bookings: Anyone on website can submit (create), only Admin can view/manage
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.keys().hasAll(['patientName', 'phone', 'careMode', 'specialty', 'status', 'createdAt'])
                    && request.resource.data.patientName is string
                    && request.resource.data.patientName.size() >= 2
                    && request.resource.data.patientName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 7
                    && request.resource.data.phone.size() <= 25;
      allow read, update, delete: if isAdmin();
    }

    // Contact & MPT Network Applications: Anyone can submit, only Admin can view/manage
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'type', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120;
      allow read, update, delete: if isAdmin();
    }
  }
}
