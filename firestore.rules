rules_version = '2';

// Paste these rules into Firebase Console -> Firestore Database -> Rules
// 100% compatible with Firebase Spark (Free) Plan!
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Authorized Admin check (Update email list here if adding co-admins)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "runlifephysio@gmail.com"
      );
    }

    // 1. Dynamic Website Settings (Public Read, Admin Write)
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Verified Patient Testimonials (Public Read, Admin Write)
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Specialist Team Profiles (Public Read, Admin Write)
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Dynamic Blog / Clinical Guides (Public Read, Admin Write)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Patient Appointment Bookings (Public Create with validation, Admin Read/Update/Delete)
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.keys().hasAll(['patientName', 'phone', 'careMode', 'specialty', 'status', 'createdAt'])
                    && request.resource.data.patientName is string
                    && request.resource.data.patientName.size() >= 2
                    && request.resource.data.patientName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 7
                    && request.resource.data.phone.size() <= 30;
      allow read, update, delete: if isAdmin();
    }

    // 6. Contact & MPT Network Inquiries (Public Create, Admin Read/Update/Delete)
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'type', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120;
      allow read, update, delete: if isAdmin();
    }
  }
}
